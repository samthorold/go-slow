# Every environment variable go-slow reads, with a safe local value.
# Copy to .env (gitignored) before `docker compose up` or a local run.

# TCP port the app listens on.
PORT=8080

# SQLite file holding the Record. Relative to the working directory: the repo
# root for a local run, /app (with a volume on /app/data) in the image.
DATABASE_PATH=data/go-slow.db

# Contact address Collection puts in its User-Agent, so a publisher can reach
# whoever runs it. Set your own; never commit a real one.
COLLECTION_CONTACT=owner@example.org

# How often Collection checks the Sources (a Go duration). Feeds are fetched
# conditionally, so an unchanged feed costs the publisher a 304.
COLLECTION_INTERVAL=15m

# The Claude model the Editor reads Items with. Which model runs which act is
# chosen by measurement on the recorded fixtures. Every *_MODEL is a pinned
# model ID, never an alias the provider can move: claude-haiku-5-5 and
# claude-opus-5-5 are themselves fixed snapshots (dateless IDs are, from the
# 4.6 generation on; see docs/research/models.md). Changing one is a
# re-record, like changing the act's instructions.
READING_MODEL=claude-haiku-5-5

# The Claude model the Editor places Facts with, weighing each against the
# Stories that share its Entities.
PLACING_MODEL=claude-haiku-5-5

# The Claude model the Editor connects Facts with: each Entity's role in a
# Fact, and causes between Facts.
CONNECTING_MODEL=claude-haiku-5-5

# The Claude model the Editor writes the Briefing with, in real time.
BRIEFING_MODEL=claude-haiku-5-5

# The Claude model the Editor writes the Sunday read with, as an agent with
# tools over the Record and Wikidata. It is written on Sundays at
# BRIEFING_TIME, just after the Briefing.
SUNDAY_READ_MODEL=claude-opus-5-5

# When the Briefing is written, and due by: a 24-hour time of day in TZ. A
# day with no Briefing by then is flagged as missed.
BRIEFING_TIME=07:00

# Key for Anthropic's API. Set your own; never commit a real one. With this
# placeholder the app runs, and every reading fails (and is retried on the
# next Collection run) until a real key is set. Not named ANTHROPIC_API_KEY:
# Claude Code reads that name too, and switches its own login and billing to it.
GOSLOW_ANTHROPIC_API_KEY=set-your-own

# The Owner's time zone, which decides what "today" is. Read by Go's runtime.
TZ=Europe/London
