2\u043e\u043c\u0443 \u0447\u0438\u0441\u043b\u0456 \u0431\u0443\u0434\u044c-\u044f\u043a\u0443 \u0456\u043d\u0448\u0443 \u0442\u0435\u0440\u0438\u0442\u043e\u0440\u0456\u044e \u0437\u0430 \u043c\u0435\u0436\u0430\u043c\u0438 \u0442\u0435\u0440\u0438\u0442\u043e\u0440\u0456\u0430\u043b\u044c\u043d\u0438\u0445 \u0432\u043e\u0434 \u0423\u043a\u0440\u0430\u0457\u043d\u0438, \u044f\u043a\u0430 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u043e \u0434\u043e \u043c\u0456\u0436\u043d\u0430\u0440\u043e\u0434\u043d\u043e\u0433\u043e \u043f\u0440\u0430\u0432\u0430 \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u0430 \u0430\u0431\u043e \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u0432 \u043f\u043e\u0434\u0430\u043b\u044c\u0448\u043e\u043c\u0443 \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u0430 \u044f\u043a \u0442\u0435\u0440\u0438\u0442\u043e\u0440\u0456\u044f, \u0443 \u043c\u0435\u0436\u0430\u0445 \u044f\u043a\u043e\u0457 \u043c\u043e\u0436\u0443\u0442\u044c \u0437\u0434\u0456\u0439\u0441\u043d\u044e\u0432\u0430\u0442\u0438\u0441\u044c \u043f\u0440\u0430\u0432\u0430 \u0423\u043a\u0440\u0430\u0457\u043d\u0438 \u0441\u0442\u043e\u0441\u043e\u0432\u043d\u043e \u043c\u043e\u0440\u0441\u044c\u043a\u043e\u0433\u043e \u0434\u043d\u0430, \u043d\u0430\u0434\u0440 \u0442\u0430 \u0457\u0445\u043d\u0456\u0445 \u043f\u0440\u0438\u0440\u043e\u0434\u043d\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432;","language":"uk"},"type":"monolingualtext"},"datatype":"monolingualtext"}]},"snaks-order":["P4051","P1683"]}]}]},"id":"Q212","labels":{"en":{"language":"en","value":"Ukraine"}},"lastrevid":2572922490,"modified":"2026-11-21T00:27:03Z","ns":0,"pageid":354,"title":"Q212","type":"item"},"Q5412157":{"aliases":{"en":[{"language":"en","value":"HielohitooEurope PMC"},{"language":"en","value":"UKPMhC"},{"language":"en","value":"Arsingoli"}]},"claims":{"P31":[{"mainsnak":{"snaktype":"value","property":"P31","hash":"b9afac0a93174ad93f06667eb2fa72ad693284be","datavalue